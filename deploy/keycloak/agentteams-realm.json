{
  "realm": "agentteams",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "task:read" },
      { "name": "task:create" },
      { "name": "task:cancel" },
      { "name": "task:retry" },
      { "name": "task:pause" },
      { "name": "task:approve" },
      { "name": "task:reject" },
      { "name": "artifact:read" },
      { "name": "artifact:write" },
      { "name": "agent:read" },
      { "name": "agent:write" },
      { "name": "config:read" },
      { "name": "config:write" },
      { "name": "usage:read" },
      { "name": "quota:write" },
      { "name": "team:read" },
      { "name": "team:write" },
      { "name": "team:approve" },
      { "name": "model:read" },
      { "name": "model:write" },
      { "name": "agent-spec:read" },
      { "name": "agent-spec:write" },
      { "name": "skill:read" },
      { "name": "skill:write" },
      { "name": "mcp:read" },
      { "name": "mcp:write" },
      { "name": "memory:read" },
      { "name": "memory:govern" },
      { "name": "memory:export" },
      { "name": "sandbox:read" },
      { "name": "usage:export" },
      { "name": "dashboard:write" },
      { "name": "audit:read" },
      { "name": "platform:organization:create" },
      { "name": "platform:organization:read" },
      { "name": "organization:admin" },
      { "name": "organization:write" },
      { "name": "integration:manage" },
      { "name": "credential:manage" },
      { "name": "provisioning-policy:manage" },
      { "name": "external-user:manage" },
      { "name": "user:manage" }
    ]
  },
  "clients": [
    {
      "clientId": "agentteams-api",
      "name": "AgentTeams API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "clientAuthenticatorType": "none",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://192.168.1.16:30080/auth/callback",
        "http://localhost:30080/auth/callback",
        "http://127.0.0.1:30080/auth/callback",
        "http://api.agentteams.localhost:30080/auth/callback"
      ],
      "webOrigins": [
        "http://192.168.1.16:30080",
        "http://localhost:30080",
        "http://127.0.0.1:30080",
        "http://api.agentteams.localhost:30080"
      ],
      "protocolMappers": [
        {
          "name": "agentteams-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agentteams-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant",
            "claim.name": "tenant",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "project",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "project",
            "claim.name": "project",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "team",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "team",
            "claim.name": "team",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "permissions",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
